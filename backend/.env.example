# FireMind backend configuration - EXAMPLE ONLY.
# Copy to .env (gitignored) or export these variables in your shell.
# NEVER commit real credentials.
#
# The server runs WITHOUT any of these: every endpoint then serves the
# deterministic fallback recommendations.

# --- HTTP -----------------------------------------------------------------
# Port to listen on. Default: 8080
PORT=8080

# --- Amazon Bedrock (optional) -------------------------------------------
# Setting AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY enables AI mode.
# When enabled, /api/health reports aiConfigured: true.
AWS_REGION=us-east-1

# Model id used with the model-agnostic Converse API.
# Swap freely - the request/response shape does not change.
# The old anthropic.claude-3-haiku-20240307-v1:0 was retired by AWS (EOL);
# newer Anthropic models need the us. / global. inference-profile prefix.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Never use real values in a committed file. Put them in .env or your
# shell environment / secrets manager.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Only needed for temporary (STS) credentials.
# AWS_SESSION_TOKEN=

# AI request timeout in milliseconds. Default: 12000
BEDROCK_TIMEOUT_MS=12000

# IAM permission required on the above credentials:
#   bedrock:InvokeModel   (on the chosen model)
